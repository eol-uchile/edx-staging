@startuml

!define C4Container https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
!include C4Container

skinparam svgLinkTarget foo

System_Boundary(c1, "edx-platform: edx-staging", $link="https://github.com/eol-uchile/edx-staging") {
    System_Boundary(c2, "requirements", $link="https://github.com/eol-uchile/edx-staging/blob/openuchile-release/koa/requirements/") {
        
            System_Boundary(apps, "apps", $link="https://github.com/eol-uchile/edx-staging/blob/openuchile-release/koa/requirements/apps.txt") {
            
                Container(apps1, "course_classification", $link="https://github.com/eol-uchile/course_classification/releases/tag/1.6.1+l")
            
                Container(apps2, "eol_certificates", $link="https://github.com/eol-uchile/eol-certificates/releases/tag/0.2.0+l")
            
                Container(apps3, "eol_contact_form", $link="https://github.com/eol-uchile/eol_contact_form/releases/tag/0.5.3+l")
            
                Container(apps4, "eol_duplicate_xblock", $link="https://github.com/eol-uchile/eol_duplicate_xblock/releases/tag/1.0.0+l")
            
                Container(apps5, "eol_sso", $link="https://github.com/eol-uchile/eol_sso/releases/tag/2.1.0+l")
            
                Container(apps6, "eol_sso_login", $link="https://github.com/eol-uchile/eol_sso_login/releases/tag/0.1.2+l")
            
                Container(apps7, "eol_survey", $link="https://github.com/eol-uchile/eol_survey/releases/tag/3.2.1+l")
            
                Container(apps8, "eol_vimeo", $link="https://github.com/eol-uchile/eol_vimeo/releases/tag/2.0.0+dev5")
            
                Container(apps9, "edx-proctoring", $link="https://github.com/openedx/edx-proctoring/releases/tag/2.6.7")
            
            }
        
            System_Boundary(python_packages, "python_packages", $link="https://github.com/eol-uchile/edx-staging/blob/openuchile-release/koa/requirements/python_packages.txt") {
            
                Container(python_packages1, "django-redis")
            
                Container(python_packages2, "edx-username-changer", $link="https://github.com/mitodl/edx-username-changer.git/releases/tag/main")
            
                Container(python_packages3, "fluent-logger")
            
                Container(python_packages4, "python-json-logger")
            
            }
        
            System_Boundary(reports, "reports", $link="https://github.com/eol-uchile/edx-staging/blob/openuchile-release/koa/requirements/reports.txt") {
            
                Container(reports1, "eol_report_analytics", $link="https://github.com/eol-uchile/eol_report_analytics/releases/tag/2.1.0+l")
            
                Container(reports2, "xblockcompletion", $link="https://github.com/eol-uchile/eol_xblock_completion/releases/tag/1.1.0+l")
            
            }
        
            System_Boundary(tabs_plugins, "tabs_plugins", $link="https://github.com/eol-uchile/edx-staging/blob/openuchile-release/koa/requirements/tabs_plugins.txt") {
            
                Container(tabs_plugins1, "eol_completion", $link="https://github.com/eol-uchile/eol_completion/releases/tag/2.1.2+l")
            
                Container(tabs_plugins2, "welcome-mail", $link="https://github.com/eol-uchile/eol_welcome_mail/releases/tag/0.0.1+l")
            
            }
        
            System_Boundary(xblocks, "xblocks", $link="https://github.com/eol-uchile/edx-staging/blob/openuchile-release/koa/requirements/xblocks.txt") {
            
                Container(xblocks1, "ora2", $link="https://github.com/eol-uchile/edx-ora2/commit/e873498bd2671b830f19a2441ec1608b7d4bbbc4")
            
                Container(xblocks2, "edx-sga", $link="https://github.com/eol-uchile/edx-sga/releases/tag/0.10.0+eol3.1.2")
            
                Container(xblocks3, "scormxblock-xblock", $link="https://github.com/eol-uchile/edx_xblock_scorm/releases/tag/0.5.1+l")
            
                Container(xblocks4, "eolcontainer-xblock", $link="https://github.com/eol-uchile/eol-container-xblock/releases/tag/v1.2.0+l")
            
                Container(xblocks5, "eolcourseprogram-xblock", $link="https://github.com/eol-uchile/eol-course-program-xblock/releases/tag/0.2.0+l")
            
                Container(xblocks6, "eol_forum_notifications", $link="https://github.com/eol-uchile/eol_forum_notifications/releases/tag/1.0.4+l")
            
                Container(xblocks7, "eolgradediscussion", $link="https://github.com/eol-uchile/eol_gradeforum_xblock/releases/tag/1.0.0+l")
            
                Container(xblocks8, "eollistgrade-xblock", $link="https://github.com/eol-uchile/eol_list_grade/releases/tag/1.0.0+l")
            
                Container(xblocks9, "eoldiscussion", $link="https://github.com/eol-uchile/eol_xblock_discussion/releases/tag/2.0.0+l")
            
                Container(xblocks10, "xblock-free-text-response", $link="https://github.com/eol-uchile/free-text-response/releases/tag/0.4.1+l")
            
                Container(xblocks11, "pdf-xblock", $link="https://github.com/eol-uchile/pdfXBlock/releases/tag/v0.5.1+l")
            
                Container(xblocks12, "sence-xblock", $link="https://github.com/eol-uchile/sence-xblock/releases/tag/2.0.0+l")
            
                Container(xblocks13, "eolpersistenttab-xblock", $link="https://github.com/eol-uchile/eol-persistent-tab-xblock/releases/tag/1.0.0+l")
            
                Container(xblocks14, "invideoquiz", $link="https://github.com/eol-uchile/xblock-in-video-quiz/releases/tag/1.1.0+l")
            
            }
        
    }

    System_Boundary(theme, "Themes", $link="https://github.com/eol-uchile/edx-staging/blob/openuchile-release/koa/themes/") {
        
            Container(theme1, "open-uchile-theme", $link="https://github.com/eol-uchile/open-uchile-theme.git")
        
    }

    System_Boundary(dockerfile, "edx-platform base", $link="https://github.com/eol-uchile/edx-staging/blob/openuchile-release/koa/Dockerfile") {
            Container(dk, "testing-ou-koa", $link="https://ghcr.io/eol-uchile/edx-platform:testing-ou-koa")
    }
}

SHOW_LEGEND()

@enduml